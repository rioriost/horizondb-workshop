@@ -0,0 +1,123 @@
+param location string
+param tags object
+param token string
+param clientIp string
+param vaultUri string
+param identityName string
+param identityResourceId string
+param identityPrincipalId string
+param infrastructureSubnetId string
+
+var infrastructureGroupName = 'ME-zava-${token}'
+
+module logs 'br/public:avm/res/operational-insights/workspace:0.16.2' = {
+  name: 'container-logs'
+  params: {
+    name: 'log-zava-${token}'
+    location: location
+    tags: tags
+    skuName: 'PerGB2018'
+    dataRetention: 30
+    dailyQuotaGb: '0.1'
+    forceCmkForQuery: false
+    enableTelemetry: false
+  }
+}
+
+module stack 'br/public:avm/ptn/azd/container-apps-stack:0.4.0' = {
+  name: 'container-stack'
+  params: {
+    location: location
+    tags: tags
+    containerAppsEnvironmentName: 'cae-zava-${token}'
+    containerRegistryName: 'crzava${token}'
+    acrSku: 'Basic'
+    acrAdminUserEnabled: false
+    publicNetworkAccess: 'Enabled'
+    logAnalyticsWorkspaceName: logs.outputs.name
+    infrastructureSubnetResourceId: infrastructureSubnetId
+    infrastructureResourceGroupName: infrastructureGroupName
+    internal: false
+    zoneRedundant: false
+    workloadProfiles: [
+      {
+        name: 'Consumption'
+        workloadProfileType: 'Consumption'
+      }
+    ]
+    enableTelemetry: false
+  }
+}
+
+module app 'br/public:avm/ptn/azd/acr-container-app:0.5.0' = {
+  name: 'container-web'
+  params: {
+    name: 'ca-zava-${token}'
+    location: location
+    tags: union(tags, { 'azd-service-name': 'web' })
+    containerAppsEnvironmentName: stack.outputs.environmentName
+    containerRegistryName: stack.outputs.registryName
+    identityName: identityName
+    identityType: 'UserAssigned'
+    userAssignedIdentityResourceId: identityResourceId
+    principalId: identityPrincipalId
+    // azd replaces this port-8080 bootstrap image with the real Node.js image.
+    imageName: 'mcr.microsoft.com/dotnet/samples:aspnetapp'
+    containerName: 'web'
+    containerCpuCoreCount: '0.5'
+    containerMemory: '1Gi'
+    containerMinReplicas: 0
+    containerMaxReplicas: 1
+    targetPort: 8080
+    ingressAllowInsecure: false
+    revisionMode: 'Single'
+    ipSecurityRestrictions: [
+      {
+        name: 'workshop-client'
+        action: 'Allow'
+        ipAddressRange: '${clientIp}/32'
+      }
+    ]
+    secrets: [
+      {
+        name: 'db-app-password'
+        keyVaultUrl: '${vaultUri}/secrets/db-app-password'
+        identity: identityResourceId
+      }
+    ]
+    env: [
+      { name: 'PORT', value: '8080' }
+      { name: 'PGHOST', value: '' }
+      { name: 'PGPORT', value: '5432' }
+      { name: 'PGDATABASE', value: 'postgres' }
+      { name: 'PGUSER', value: 'zava_app' }
+      { name: 'PGPASSWORD', secretRef: 'db-app-password' }
+    ]
+    containerProbes: [
+      {
+        type: 'Startup'
+        tcpSocket: { port: 8080 }
+        periodSeconds: 10
+        failureThreshold: 10
+      }
+      {
+        type: 'Liveness'
+        tcpSocket: { port: 8080 }
+        periodSeconds: 10
+      }
+      {
+        type: 'Readiness'
+        tcpSocket: { port: 8080 }
+        periodSeconds: 5
+      }
+    ]
+    enableTelemetry: false
+  }
+}
+
+output resourceId string = app.outputs.resourceId
+output name string = app.outputs.name
+output hostname string = replace(app.outputs.uri, 'https://', '')
+output environmentName string = stack.outputs.environmentName
+output registryEndpoint string = stack.outputs.registryLoginServer
+output infrastructureGroupName string = infrastructureGroupName
