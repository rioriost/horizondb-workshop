@@ -0,0 +1,25 @@
+import { spawn } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import { environment, requireValues } from './azure.mjs';
+
+const values = await environment();
+requireValues(values, ['PGHOST', 'PG_ADMIN_PASSWORD']);
+const child = spawn('psql', [
+  '--host', values.PGHOST, '--port', '5432', '--username', 'workshop_admin',
+  '--dbname', 'postgres', '--set', 'ON_ERROR_STOP=1',
+], {
+  stdio: 'inherit',
+  env: {
+    ...process.env, PGPASSWORD: values.PG_ADMIN_PASSWORD, PGSSLMODE: 'verify-full',
+    PGSSLROOTCERT: fileURLToPath(new URL('../src/zava-designer-agent-ui-demo/certs/roots.pem', import.meta.url)),
+  },
+});
+process.on('SIGINT', () => {});
+child.on('error', error => {
+  console.error(`psql could not start: ${error.message}. Install PostgreSQL client tools first.`);
+  process.exitCode = 1;
+});
+child.on('exit', (code, signal) => {
+  if (signal) console.error(`psql terminated with signal ${signal}.`);
+  process.exitCode = code ?? 1;
+});
diff --git a/sql/bootstrap.sql b/sql/bootstrap.sql
new file mode 100644
