+targetScope = 'subscription'
+
+@minLength(1)
+@maxLength(60)
+param environmentName string
+
+param location string
+
+@allowed([
+  'containerapp'
+  'appservice'
+])
+param hostingTarget string = 'containerapp'
+
+@secure()
+param administratorPassword string
+
+@secure()
+param applicationPassword string
+
+param clientIp string
+
+var tags = {
+  'azd-env-name': environmentName
+  purpose: 'horizondb-workshop'
+}
+
+resource resourceGroup 'Microsoft.Resources/resourceGroups@2025-04-01' = {
+  name: 'rg-${environmentName}'
+  location: location
+  tags: tags
+}
+
+module resources 'resources.bicep' = {
+  name: 'zava-resources'
+  scope: resourceGroup
+  params: {
+    location: location
+    hostingTarget: hostingTarget
+    tags: tags
+    administratorPassword: administratorPassword
+    applicationPassword: applicationPassword
+    clientIp: clientIp
+  }
+}
+
+output AZURE_RESOURCE_GROUP string = resourceGroup.name
+output AZURE_DEPLOYED_HOSTING_TARGET string = hostingTarget
+output AZURE_DEPLOY_CONTAINER_APPS bool = hostingTarget == 'containerapp'
+output AZURE_DEPLOY_APP_SERVICE bool = hostingTarget == 'appservice'
+output AZURE_HORIZONDB_CLUSTER_ID string = resources.outputs.clusterId
+output AZURE_HORIZONDB_POOL_NAME string = resources.outputs.poolName
+output AZURE_HORIZONDB_PARAMETER_GROUP_ID string = resources.outputs.parameterGroupId
+output AZURE_WEB_RESOURCE_ID string = resources.outputs.webResourceId
+output AZURE_WEB_NAME string = resources.outputs.webName
+output AZURE_WEB_HOSTNAME string = resources.outputs.webHostname
+output AZURE_KEY_VAULT_NAME string = resources.outputs.keyVaultName
+output AZURE_APP_EGRESS_IP string = resources.outputs.appEgressIp
+output AZURE_CONTAINER_ENVIRONMENT_NAME string = resources.outputs.containerEnvironmentName
+output AZURE_CONTAINER_REGISTRY_ENDPOINT string = resources.outputs.registryEndpoint
+output AZURE_CONTAINER_INFRASTRUCTURE_GROUP string = resources.outputs.infrastructureGroupName
+output SERVICE_WEB_ENDPOINT string = 'https://${resources.outputs.webHostname}'
