diff --git a/tests/deployment.test.mjs b/tests/deployment.test.mjs
new file mode 100644
index 0000000..a286304
--- /dev/null
+++ b/tests/deployment.test.mjs
@@ -0,0 +1,94 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  containerDatabaseHost, firewallIps, hostingTarget, needsRestart, readWriteHostname, waitForOperation,
+} from '../scripts/azure.mjs';
+
+test('use the service-generated cluster writer instead of a pool reader', () => {
+  const endpoints = { value: [
+    { properties: { scope: 'Pool', role: 'ReadOnly', fullyQualifiedDomainName: 'reader.example.net' } },
+    { properties: { scope: 'Cluster', role: 'ReadWrite', fullyQualifiedDomainName: 'writer.example.net' } },
+  ] };
+  assert.equal(readWriteHostname(endpoints), 'writer.example.net');
+  assert.throws(() => readWriteHostname({ value: [endpoints.value[0]] }), /ReadWrite endpoint/);
+  assert.throws(() => readWriteHostname({ value: [endpoints.value[1], endpoints.value[1]] }), /ReadWrite endpoint/);
+});
+
+test('restart pending static changes, preserve synchronized pools and surface failed application', () => {
+  const pool = syncStatus => ({ properties: { parameterGroup: { syncStatus } } });
+  assert.equal(needsRestart(pool('PendingReboot')), true);
+  assert.equal(needsRestart(pool('InSync')), false);
+  assert.throws(() => needsRestart(pool('FailedToApply')), /failed to apply/);
+});
+
+test('deduplicate real outbound addresses and reject missing or invalid firewall data', () => {
+  assert.deepEqual(firewallIps('20.1.2.3, 20.1.2.3,20.4.5.6'), ['20.1.2.3', '20.4.5.6']);
+  assert.throws(() => firewallIps(''), /IPv4/);
+  assert.throws(() => firewallIps('20.1.2.3,0.0.0.0/0'), /IPv4/);
+  assert.throws(() => firewallIps('0.0.0.0'), /IPv4/);
+  assert.throws(() => firewallIps(undefined), /IPv4/);
+});
+
+test('default to Container Apps and reject unknown or mismatched hosting targets', () => {
+  assert.equal(hostingTarget({}), 'containerapp');
+  assert.equal(hostingTarget({
+    AZURE_HOSTING_TARGET: 'appservice', AZURE_DEPLOYED_HOSTING_TARGET: 'appservice',
+  }, true), 'appservice');
+  assert.throws(() => hostingTarget({ AZURE_HOSTING_TARGET: 'aks' }), /must be/);
+  assert.throws(() => hostingTarget({
+    AZURE_HOSTING_TARGET: 'appservice', AZURE_DEPLOYED_HOSTING_TARGET: 'containerapp',
+  }), /fresh azd environment/);
+  assert.throws(() => hostingTarget({}, true), /azd provision/);
+});
+
+test('configure the container database host without losing secret references or revision settings', () => {
+  const resource = { properties: { template: {
+    scale: { minReplicas: 0, maxReplicas: 1 },
+    containers: [{ name: 'web', image: 'registry.example/web:1', env: [
+      { name: 'PGHOST', value: '' }, { name: 'PGPASSWORD', secretRef: 'db-app-password' },
+    ] }],
+  } } };
+  const patch = containerDatabaseHost(resource, 'writer.example.net');
+  assert.deepEqual(patch.properties.template.scale, resource.properties.template.scale);
+  assert.deepEqual(patch.properties.template.containers[0].env, [
+    { name: 'PGPASSWORD', secretRef: 'db-app-password' },
+    { name: 'PGHOST', value: 'writer.example.net' },
+  ]);
+  assert.equal(resource.properties.template.containers[0].env[0].value, '');
+  assert.throws(() => containerDatabaseHost({ properties: { template: { containers: [] } } }, 'writer'),
+    /exactly one/);
+});
+
+test('wait for ARM asynchronous completion instead of treating acceptance as success', async () => {
+  const initial = new Response(null, { status: 202, headers: {
+    'azure-asyncoperation': 'https://management.azure.com/operations/test?api-version=1',
+    'retry-after': '0',
+  } });
+  const statuses = ['InProgress', 'Succeeded'];
+  let calls = 0;
+  await waitForOperation(async (method, url) => {
+    assert.equal(method, 'GET');
+    assert.equal(url, 'https://management.azure.com/operations/test?api-version=1');
+    return Response.json({ status: statuses[calls++] }, { headers: { 'retry-after': '0' } });
+  }, initial);
+  assert.equal(calls, 2);
+});
+
+test('surface the provider error when an accepted ARM operation fails', async () => {
+  const initial = new Response(null, { status: 202, headers: {
+    'azure-asyncoperation': '/operations/test', 'retry-after': '0',
+  } });
+  await assert.rejects(waitForOperation(async () => Response.json({
+    status: 'Failed', error: { code: 'ModelUnavailable', message: 'Managed model provisioning failed.' },
+  }), initial), /ModelUnavailable.*Managed model provisioning failed/);
+});
+
+test('support Location completion and reject missing or untrusted polling URLs', async () => {
+  await waitForOperation(async () => new Response(null, { status: 204 }),
+    new Response(null, { status: 202, headers: { location: '/operations/test', 'retry-after': '0' } }));
+  const unexpected = () => { throw new Error('The request must not be sent.'); };
+  await assert.rejects(waitForOperation(unexpected, new Response(null, { status: 202 })), /polling URL/);
+  await assert.rejects(waitForOperation(unexpected, new Response(null, {
+    status: 202, headers: { 'azure-asyncoperation': 'https://untrusted.example/operation' },
+  })), /unexpected operation polling origin/);
+});
