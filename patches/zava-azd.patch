+param location string
+param tags object
+param token string
+param hostingTarget string
+
+module publicIp 'br/public:avm/res/network/public-ip-address:0.13.0' = {
+  name: 'application-egress-ip'
+  params: {
+    name: 'pip-zava-${token}'
+    location: location
+    tags: tags
+    skuName: 'Standard'
+    publicIPAllocationMethod: 'Static'
+    publicIPAddressVersion: 'IPv4'
+    availabilityZones: []
+    enableTelemetry: false
+  }
+}
+
+module nat 'br/public:avm/res/network/nat-gateway:2.1.1' = {
+  name: 'application-nat'
+  params: {
+    name: 'nat-zava-${token}'
+    location: location
+    tags: tags
+    natGatewaySku: 'Standard'
+    availabilityZone: -1
+    publicIpResourceIds: [publicIp.outputs.resourceId]
+    enableTelemetry: false
+  }
+}
+
+module network 'br/public:avm/res/network/virtual-network:0.10.2' = {
+  name: 'application-virtual-network'
+  params: {
+    name: 'vnet-zava-${token}'
+    location: location
+    tags: tags
+    addressPrefixes: ['10.88.0.0/23']
+    subnets: [
+      {
+        name: 'container-apps'
+        addressPrefix: '10.88.0.0/24'
+        delegation: hostingTarget == 'containerapp' ? 'Microsoft.App/environments' : 'Microsoft.Web/serverFarms'
+        natGatewayResourceId: nat.outputs.resourceId
+      }
+      {
+        name: 'private-endpoints'
+        addressPrefix: '10.88.1.0/27'
+        privateEndpointNetworkPolicies: 'Disabled'
+      }
+    ]
+    enableTelemetry: false
+  }
+}
+
+module vaultDns 'br/public:avm/res/network/private-dns-zone:0.8.1' = {
+  name: 'vault-private-dns'
+  params: {
+    name: 'privatelink.vaultcore.azure.net'
+    tags: tags
+    virtualNetworkLinks: [
+      {
+        name: 'zava'
+        virtualNetworkResourceId: network.outputs.resourceId
+        registrationEnabled: false
+      }
+    ]
+    enableTelemetry: false
+  }
+}
+
+output hostingSubnetId string = network.outputs.subnetResourceIds[0]
+output privateEndpointSubnetId string = network.outputs.subnetResourceIds[1]
+output vaultDnsZoneId string = vaultDns.outputs.resourceId
+output egressIp string = publicIp.outputs.ipAddress
diff --git a/infra/resources.bicep b/infra/resources.bicep
new file mode 100644
index 0000000..90ed938
--- /dev/null
+++ b/infra/resources.bicep
@@ -0,0 +1,265 @@
+param location string
+param tags object
+
+param hostingTarget string
+
+@secure()
+param administratorPassword string
+
+@secure()
+param applicationPassword string
+
+param clientIp string
+
+var token = uniqueString(resourceGroup().id)
+var vaultName = 'kvzava${token}'
+var vaultUri = 'https://${vaultName}${environment().suffixes.keyvaultDns}'
+var poolName = 'primary'
+var useContainerApps = hostingTarget == 'containerapp'
+
+// HorizonDB has no published AVM module. Use its official preview ARM contract.
+resource cluster 'Microsoft.HorizonDb/clusters@2026-10-01-preview' = {
+  name: 'hdb-${token}'
+  location: location
+  tags: tags
+  properties: {
+    postgreSqlVersion: '17'
+    network: {
+      publicAccess: 'Enabled'
+    }
+    backup: {
+      geoRedundancy: 'Disabled'
+    }
+  }
+}
+
+resource passwordAuthentication 'Microsoft.HorizonDb/clusters/authentications@2026-10-01-preview' = {
+  parent: cluster
+  name: 'passwordMethod'
+  properties: {
+    state: 'Enabled'
+    #disable-next-line use-secure-value-for-secure-inputs
+    administratorLogin: 'workshop_admin'
+    administratorLoginPassword: administratorPassword
+  }
+  dependsOn: [
+    pool
+  ]
+}
+
+resource pool 'Microsoft.HorizonDb/clusters/pools@2026-10-01-preview' = {
+  parent: cluster
+  name: poolName
+  // The official REST contract permits omission, selecting the PG17 default group.
+  #disable-next-line BCP035
+  properties: {
+    computeModel: {
+      type: 'Provisioned'
+      computeProcessor: 'Intel'
+      computeGeneration: 1
+      vCores: 2
+    }
+    nodeCount: 1
+    highAvailability: {
+      mode: 'Disabled'
+    }
+  }
+}
+
+resource clientFirewall 'Microsoft.HorizonDb/clusters/pools/firewallRules@2026-10-01-preview' = {
+  parent: pool
+  name: 'workshop-client'
+  properties: {
+    startIpAddress: clientIp
+    endIpAddress: clientIp
+  }
+  dependsOn: [
+    passwordAuthentication
+  ]
+}
+
+resource parameterGroup 'Microsoft.HorizonDb/parameterGroups@2026-10-01-preview' = {
+  name: 'zava-${token}'
+  location: location
+  tags: tags
+  properties: {
+    postgreSqlVersion: '17'
+    description: 'HorizonDB SQL AI and AGE workshop extensions'
+    parameters: [
+      {
+        name: 'azure.extensions'
+        value: 'azure_ai,vector,pg_diskann,pg_textsearch,pg_durable,age'
+      }
+      {
+        name: 'shared_preload_libraries'
+        value: 'pg_textsearch,pg_durable,age'
+      }
+    ]
+  }
+}
+
+module network 'network.bicep' = {
+  name: 'application-network'
+  params: {
+    location: location
+    tags: tags
+    token: token
+    hostingTarget: hostingTarget
+  }
+}
+
+module plan 'br/public:avm/res/web/serverfarm:0.7.1' = if (!useContainerApps) {
+  name: 'hosting-plan'
+  params: {
+    name: 'asp-zava-${token}'
+    location: location
+    tags: tags
+    kind: 'linux'
+    reserved: true
+    skuName: 'B1'
+    skuCapacity: 1
+    zoneRedundant: false
+    enableTelemetry: false
+  }
+}
+
+module web 'br/public:avm/res/web/site:0.24.0' = if (!useContainerApps) {
+  name: 'web'
+  params: {
+    name: 'zava-${token}'
+    location: location
+    tags: union(tags, { 'azd-service-name': 'webapp' })
+    kind: 'app,linux'
+    serverFarmResourceId: plan!.outputs.resourceId
+    virtualNetworkSubnetResourceId: network.outputs.hostingSubnetId
+    managedIdentities: {
+      systemAssigned: true
+    }
+    httpsOnly: true
+    publicNetworkAccess: 'Enabled'
+    siteConfig: {
+      linuxFxVersion: 'NODE|24-lts'
+      appCommandLine: 'npm start'
+      alwaysOn: true
+      vnetRouteAllEnabled: true
+      minTlsVersion: '1.2'
+      ftpsState: 'Disabled'
+      ipSecurityRestrictionsDefaultAction: 'Deny'
+      ipSecurityRestrictions: [
+        {
+          name: 'workshop-client'
+          ipAddress: '${clientIp}/32'
+          action: 'Allow'
+          priority: 100
+        }
+      ]
+    }
+    configs: [
+      {
+        name: 'appsettings'
+        properties: {
+          PGHOST: ''
+          PGPORT: '5432'
+          PGDATABASE: 'postgres'
+          PGUSER: 'zava_app'
+          PGPASSWORD: '@Microsoft.KeyVault(SecretUri=${vaultUri}/secrets/db-app-password)'
+          SCM_DO_BUILD_DURING_DEPLOYMENT: 'true'
+          WEBSITE_CONTAINER_START_TIME_LIMIT: '600'
+        }
+      }
+    ]
+    enableTelemetry: false
+  }
+}
+
+module identity 'br/public:avm/res/managed-identity/user-assigned-identity:0.6.0' = if (useContainerApps) {
+  name: 'container-identity'
+  params: {
+    name: 'id-zava-${token}'
+    location: location
+    tags: tags
+    enableTelemetry: false
+  }
+}
+
+module vault 'br/public:avm/res/key-vault/vault:0.14.3' = {
+  name: 'vault'
+  params: {
+    name: vaultName
+    location: location
+    tags: tags
+    sku: 'standard'
+    enableRbacAuthorization: true
+    enablePurgeProtection: false
+    softDeleteRetentionInDays: 7
+    enableVaultForDeployment: false
+    enableVaultForTemplateDeployment: false
+    enableVaultForDiskEncryption: false
+    publicNetworkAccess: 'Disabled'
+    networkAcls: {
+      defaultAction: 'Deny'
+      bypass: 'None'
+    }
+    privateEndpoints: [
+      {
+        name: 'pep-zava-${token}'
+        subnetResourceId: network.outputs.privateEndpointSubnetId
+        privateDnsZoneGroup: {
+          privateDnsZoneGroupConfigs: [
+            { privateDnsZoneResourceId: network.outputs.vaultDnsZoneId }
+          ]
+        }
+      }
+    ]
+    secrets: [
+      {
+        name: 'db-admin-password'
+        value: administratorPassword
+      }
+      {
+        name: 'db-app-password'
+        value: applicationPassword
+        roleAssignments: [
+          {
+            principalId: useContainerApps
+              ? identity!.outputs.principalId
+              : web!.outputs.systemAssignedMIPrincipalId!
+            principalType: 'ServicePrincipal'
+            roleDefinitionIdOrName: 'Key Vault Secrets User'
+          }
+        ]
+      }
+    ]
+    enableTelemetry: false
+  }
+}
+
+module containerApp 'container-app.bicep' = if (useContainerApps) {
+  name: 'container-hosting'
+  params: {
+    location: location
+    tags: tags
+    token: token
+    clientIp: clientIp
+    vaultUri: vaultUri
+    identityName: identity!.outputs.name
+    identityResourceId: identity!.outputs.resourceId
+    identityPrincipalId: identity!.outputs.principalId
+    infrastructureSubnetId: network.outputs.hostingSubnetId
+  }
+  dependsOn: [
+    vault
+  ]
+}
+
+output clusterId string = cluster.id
+output poolName string = pool.name
+output parameterGroupId string = parameterGroup.id
+output webResourceId string = useContainerApps ? containerApp!.outputs.resourceId : web!.outputs.resourceId
+output webName string = useContainerApps ? containerApp!.outputs.name : web!.outputs.name
+output webHostname string = useContainerApps ? containerApp!.outputs.hostname : web!.outputs.defaultHostname
+output keyVaultName string = vault.outputs.name
+output appEgressIp string = network.outputs.egressIp
+output containerEnvironmentName string = useContainerApps ? containerApp!.outputs.environmentName : ''
+output registryEndpoint string = useContainerApps ? containerApp!.outputs.registryEndpoint : ''
+output infrastructureGroupName string = useContainerApps ? containerApp!.outputs.infrastructureGroupName : ''
diff --git a/scripts/azure.mjs b/scripts/azure.mjs
new file mode 100644
index 0000000..eb2fe22
--- /dev/null
+++ b/scripts/azure.mjs
@@ -0,0 +1,171 @@
+import { execFile } from 'node:child_process';
+import { promisify } from 'node:util';
+import { isIPv4 } from 'node:net';
+import { setTimeout as sleep } from 'node:timers/promises';
+import { fileURLToPath } from 'node:url';
+
+const execute = promisify(execFile);
+export const horizonApi = '2026-10-01-preview';
+export const webApi = '2025-03-01';
+export const containerApi = '2025-07-01';
+
+export async function cli(command, args) {
+  const { stdout } = await execute(command, args, {
+    encoding: 'utf8', maxBuffer: 8 * 1024 * 1024,
+    cwd: fileURLToPath(new URL('..', import.meta.url)),
+  });
+  return stdout.trim();
+}
+
+export async function environment() {
+  return JSON.parse(await cli('azd', ['env', 'get-values', '--output', 'json']));
+}
+
+export async function setEnvironment(name, value) {
+  await cli('azd', ['env', 'set', name, value]);
+}
+
+export function requireValues(values, names) {
+  for (const name of names) {
+    if (typeof values[name] !== 'string' || !values[name]) {
+      throw new Error(`Missing ${name}. Select an azd environment and run azd up.`);
+    }
+  }
+}
+
+export function firewallIps(value) {
+  if (typeof value !== 'string') throw new Error('The application did not return valid outbound IPv4 addresses.');
+  const addresses = [...new Set(value.split(',').map(ip => ip.trim()).filter(Boolean))];
+  if (!addresses.length || addresses.some(ip => !isIPv4(ip) || ip === '0.0.0.0')) {
+    throw new Error('The application did not return valid outbound IPv4 addresses.');
+  }
+  return addresses;
+}
+
+export function hostingTarget(values, requireProvisioned = false) {
+  const target = values.AZURE_HOSTING_TARGET || 'containerapp';
+  if (!['containerapp', 'appservice'].includes(target)) {
+    throw new Error('AZURE_HOSTING_TARGET must be containerapp or appservice.');
+  }
+  const deployed = values.AZURE_DEPLOYED_HOSTING_TARGET;
+  if (deployed && deployed !== target) {
+    throw new Error('Hosting target differs from the provisioned environment. Select a fresh azd environment to change hosts.');
+  }
+  if (requireProvisioned && !deployed) {
+    throw new Error('Run azd provision before deploying this environment.');
+  }
+  return target;
+}
+
+export function containerDatabaseHost(resource, hostname) {
+  const template = resource.properties?.template;
+  if (template?.containers?.length !== 1 || template.containers[0].name !== 'web') {
+    throw new Error('Expected exactly one workshop web container before configuring PGHOST.');
+  }
+  const container = template.containers[0];
+  return {
+    properties: {
+      template: {
+        ...template,
+        containers: [{
+          ...container,
+          env: [...(container.env || []).filter(item => item.name !== 'PGHOST'),
+            { name: 'PGHOST', value: hostname }],
+        }],
+      },
+    },
+  };
+}
+
+export function needsRestart(pool) {
+  const status = pool.properties.parameterGroup?.syncStatus;
+  if (status === 'FailedToApply') throw new Error('HorizonDB failed to apply the parameter group.');
+  return status === 'PendingReboot';
+}
+
+export function readWriteHostname(endpoints) {
+  const matches = endpoints.value.filter(item =>
+    item.properties.scope === 'Cluster' && item.properties.role === 'ReadWrite');
+  const hostname = matches[0]?.properties.fullyQualifiedDomainName;
+  if (matches.length !== 1 || typeof hostname !== 'string'
+      || !/^[a-z0-9][a-z0-9.-]+[a-z0-9]$/i.test(hostname)) {
+    throw new Error('Expected exactly one service-generated cluster ReadWrite endpoint.');
+  }
+  return hostname;
+}
+
+export function azureClient(subscription) {
+  let token;
+  let tokenTime = 0;
+  async function request(method, url, body) {
+    if (!token || Date.now() - tokenTime > 20 * 60 * 1000) {
+      const credentials = JSON.parse(await cli('az', [
+        'account', 'get-access-token', '--subscription', subscription,
+        '--resource', 'https://management.azure.com/', '--output', 'json',
+      ]));
+      token = credentials.accessToken;
+      if (!token) throw new Error('Azure CLI did not return a management access token.');
+      tokenTime = Date.now();
+    }
+    const response = await fetch(url, {
+      method,
+      headers: { authorization: `Bearer ${token}`, 'content-type': 'application/json' },
+      ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+      signal: AbortSignal.timeout(120000),
+    });
+    if (!response.ok) {
+      throw new Error(`ARM ${method} ${url}: HTTP ${response.status}: ${await response.text()}`);
+    }
+    return response;
+  }
+  return async function arm(method, resourceId, apiVersion, body) {
+    const response = await request(method,
+      `https://management.azure.com${resourceId}?api-version=${apiVersion}`, body);
+    const text = await response.text();
+    if (method !== 'GET') await waitForOperation(request, response);
+    return text ? JSON.parse(text) : null;
+  };
+}
+
+export async function waitForOperation(request, initialResponse) {
+  const asyncUrl = initialResponse.headers.get('azure-asyncoperation');
+  if (!asyncUrl && initialResponse.status !== 202) return;
+  const location = asyncUrl || initialResponse.headers.get('location');
+  if (!location) throw new Error('ARM accepted an operation without a polling URL.');
+  const url = new URL(location, 'https://management.azure.com');
+  if (url.origin !== 'https://management.azure.com') {
+    throw new Error('Refusing to send Azure credentials to an unexpected operation polling origin.');
+  }
+  const deadline = Date.now() + 30 * 60 * 1000;
+  let response = initialResponse;
+  while (Date.now() < deadline) {
+    const retryAfter = Number(response.headers.get('retry-after') ?? 10);
+    await sleep(Number.isFinite(retryAfter) ? Math.min(60, Math.max(1, retryAfter)) * 1000 : 10000);
+    response = await request('GET', url.href);
+    const text = await response.text();
+    const operation = text ? JSON.parse(text) : null;
+    const status = operation?.status ?? operation?.properties?.provisioningState;
+    if (['Failed', 'Canceled', 'Cancelled'].includes(status)) {
+      throw new Error(`ARM operation ${status}: ${JSON.stringify(operation.error ?? operation)}`);
+    }
+    if (status === 'Succeeded' || (!asyncUrl && response.status !== 202 && status === undefined)) return;
+    if (asyncUrl && typeof status !== 'string') {
+      throw new Error('ARM asynchronous operation did not return a status.');
+    }
+  }
+  throw new Error('ARM asynchronous operation did not finish within 30 minutes.');
+}
+
+export async function waitForResource(arm, resourceId, apiVersion, predicate, label) {
+  const deadline = Date.now() + 20 * 60 * 1000;
+  while (Date.now() < deadline) {
+    const resource = await arm('GET', resourceId, apiVersion);
+    if (['Failed', 'Canceled'].includes(resource.properties.provisioningState)
+        || resource.properties.state === 'Inaccessible') {
+      throw new Error(`${label} failed: ${JSON.stringify(resource.properties)}`);
+    }
+    if (predicate(resource)) return resource;
+    await sleep(10000);
+  }
+  throw new Error(`${label} did not become ready within 20 minutes.`);
+}
diff --git a/scripts/bootstrap.mjs b/scripts/bootstrap.mjs
new file mode 100644
index 0000000..1299c5e
--- /dev/null
+++ b/scripts/bootstrap.mjs
@@ -0,0 +1,139 @@
+import { createRequire } from 'node:module';
+import { readFile } from 'node:fs/promises';
+import { createReadStream } from 'node:fs';
+import { pipeline } from 'node:stream/promises';
+import { setTimeout as sleep } from 'node:timers/promises';
+import { fileURLToPath } from 'node:url';
+
+const require = createRequire(new URL('../src/zava-designer-agent-ui-demo/package.json', import.meta.url));
+
+export async function databaseClient(values, user = 'workshop_admin', password = values.PG_ADMIN_PASSWORD) {
+  const { Client } = require('pg');
+  const ca = await readFile(new URL('../src/zava-designer-agent-ui-demo/certs/roots.pem', import.meta.url), 'utf8');
+  const deadline = Date.now() + 5 * 60 * 1000;
+  while (Date.now() < deadline) {
+    const client = new Client({
+      host: values.PGHOST, port: 5432, database: 'postgres', user, password,
+      connectionTimeoutMillis: 15000, statement_timeout: 180000,
+      ssl: { ca, rejectUnauthorized: true },
+    });
+    try {
+      await client.connect();
+      return client;
+    } catch (error) {
+      await client.end();
+      if (!['ETIMEDOUT', 'ECONNREFUSED', 'ECONNRESET', 'EHOSTUNREACH', '57P03'].includes(error.code)) {
+        throw error;
+      }
+      console.log(`Waiting for database connectivity (${error.code}).`);
+      await sleep(10000);
+    }
+  }
+  throw new Error('Database connection did not become ready within five minutes.');
+}
+
+function literal(value) {
+  if (typeof value !== 'string' || value.length < 24 || value.length > 128) {
+    throw new Error('Expected a generated application password of 24 to 128 characters.');
+  }
+  return `'${value.replaceAll("'", "''")}'`;
+}
+
+export async function bootstrap(client, values) {
+  const { from } = require('pg-copy-streams');
+  await client.query(await readFile(new URL('../sql/bootstrap.sql', import.meta.url), 'utf8'));
+  const modelsDeadline = Date.now() + 10 * 60 * 1000;
+  let models;
+  while (Date.now() < modelsDeadline) {
+    models = (await client.query(`
+      SELECT alias, model_name, status FROM model_registry.model_list_all()
+      WHERE alias IN ('default-embedding', 'default-chat', 'default-reranker')
+    `)).rows;
+    if (models.length === 3) break;
+    console.log(`Waiting for managed models (${models.length}/3 aliases registered).`);
+    await sleep(15000);
+  }
+  if (models.length !== 3) throw new Error('All three managed model aliases must be available.');
+
+  await client.query('BEGIN');
+  try {
+    const count = Number((await client.query('SELECT count(*) FROM workshop.products')).rows[0].count);
+    if (count === 0) {
+      await pipeline(
+        createReadStream(fileURLToPath(new URL('../data/products.csv', import.meta.url))),
+        client.query(from(`COPY workshop.products
+          (id, title, title_ja, category, price, rating, style, content)
+          FROM STDIN WITH (FORMAT csv, HEADER true, ENCODING 'UTF8')`)),
+      );
+    } else if (count !== 18) {
+      throw new Error(`Found ${count} products; expected the 18-product workshop catalog. Existing data was not replaced.`);
+    }
+    await client.query('COMMIT');
+  } catch (error) {
+    await client.query('ROLLBACK');
+    throw error;
+  }
+
+  await client.query(`
+    UPDATE workshop.products
+    SET embedding = ai.embed(text => content, model => 'default-embedding', dimensions => 1536)::vector(1536)
+    WHERE embedding IS NULL;
+    CREATE INDEX IF NOT EXISTS products_embedding_diskann_idx ON workshop.products
+      USING diskann (embedding vector_cosine_ops);
+    CREATE INDEX IF NOT EXISTS products_content_bm25_idx ON workshop.products
+      USING bm25 (content) WITH (text_config = 'english');
+    ANALYZE workshop.products;
+  `);
+  const graphExists = (await client.query(
+    "SELECT EXISTS(SELECT 1 FROM ag_catalog.ag_graph WHERE name = 'workshop_style') AS present",
+  )).rows[0].present;
+  if (!graphExists) {
+    await client.query('BEGIN');
+    try {
+      await client.query(await readFile(new URL('../sql/graph.sql', import.meta.url), 'utf8'));
+      await client.query('COMMIT');
+    } catch (error) {
+      await client.query('ROLLBACK');
+      throw error;
+    }
+  }
+
+  const role = (await client.query(`SELECT rolsuper, rolcreatedb, rolcreaterole, rolreplication, rolbypassrls
+    FROM pg_roles WHERE rolname = 'zava_app'`)).rows[0];
+  if (role && Object.values(role).some(Boolean)) {
+    throw new Error('Existing zava_app role has elevated privileges; refusing to reuse it.');
+  }
+  await client.query(role
+    ? `ALTER ROLE zava_app LOGIN PASSWORD ${literal(values.PG_APP_PASSWORD)}`
+    : `CREATE ROLE zava_app LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE PASSWORD ${literal(values.PG_APP_PASSWORD)}`);
+  await client.query(`
+    GRANT CONNECT ON DATABASE postgres TO zava_app;
+    GRANT USAGE ON SCHEMA public, workshop, ai, ag_catalog, workshop_style TO zava_app;
+    GRANT SELECT ON ALL TABLES IN SCHEMA workshop, workshop_style, ag_catalog TO zava_app;
+    GRANT EXECUTE ON ALL FUNCTIONS IN SCHEMA ai TO zava_app;
+    GRANT EXECUTE ON FUNCTION ag_catalog.cypher(name, cstring, ag_catalog.agtype) TO zava_app;
+  `);
+  const checks = (await client.query(`
+    SELECT count(*)::integer AS products, count(embedding)::integer AS embedded,
+      min(vector_dims(embedding)) AS min_dimensions, max(vector_dims(embedding)) AS max_dimensions
+    FROM workshop.products
+  `)).rows[0];
+  const graphProducts = Number((await client.query(`
+    SELECT * FROM ag_catalog.cypher('workshop_style',
+      $$MATCH (p:Product) RETURN count(p)$$) AS (count ag_catalog.agtype)
+  `)).rows[0].count);
+  const indexes = (await client.query(`
+    SELECT i.relname AS name, am.amname AS method FROM pg_index AS idx
+    JOIN pg_class AS i ON i.oid = idx.indexrelid
+    JOIN pg_am AS am ON am.oid = i.relam
+    WHERE idx.indrelid = 'workshop.products'::regclass
+      AND idx.indisvalid AND idx.indisready AND am.amname IN ('diskann', 'bm25')
+  `)).rows;
+  if (checks.products !== 18 || checks.embedded !== 18 || checks.min_dimensions !== 1536
+      || checks.max_dimensions !== 1536 || graphProducts !== 18
+      || !indexes.some(index => index.method === 'diskann') || !indexes.some(index => index.method === 'bm25')) {
+    throw new Error(`Incomplete database initialization: ${JSON.stringify({ checks, graphProducts, indexes })}`);
+  }
+  const extensions = (await client.query('SELECT extname, extversion FROM pg_extension ORDER BY extname')).rows;
+  return { checks, graphProducts, indexes, extensions, models };
+}
diff --git a/scripts/hooks.mjs b/scripts/hooks.mjs
new file mode 100644
index 0000000..173f993
--- /dev/null
+++ b/scripts/hooks.mjs
@@ -0,0 +1,243 @@
+import { randomBytes, X509Certificate } from 'node:crypto';
+import { isIPv4 } from 'node:net';
+import { mkdir, readFile, writeFile, chmod } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { setTimeout as sleep } from 'node:timers/promises';
+import {
+  azureClient, cli, containerApi, containerDatabaseHost, environment, firewallIps,
+  horizonApi, hostingTarget, needsRestart,
+  readWriteHostname, requireValues, setEnvironment, waitForResource, webApi,
+} from './azure.mjs';
+import { bootstrap, databaseClient } from './bootstrap.mjs';
+
+const appDirectory = fileURLToPath(new URL('../src/zava-designer-agent-ui-demo/', import.meta.url));
+
+async function prepare() {
+  if (Number(process.versions.node.split('.')[0]) < 24) throw new Error('Node.js 24 or newer is required.');
+  await cli('npm', ['--prefix', appDirectory, 'ci', '--no-audit', '--no-fund']);
+  await prepareCertificates();
+  console.log('Prepared dependencies and verified public TLS root certificates.');
+}
+
+async function prepareCertificates() {
+  const certificates = [
+    'https://www.microsoft.com/pkiops/certs/Microsoft%20RSA%20Root%20Certificate%20Authority%202017.crt',
+    'https://cacerts.digicert.com/DigiCertGlobalRootG2.crt',
+  ];
+  const roots = [];
+  for (const url of certificates) {
+    const response = await fetch(url, { signal: AbortSignal.timeout(30000) });
+    if (!response.ok) throw new Error(`Certificate download failed: HTTP ${response.status}: ${url}`);
+    const certificate = new X509Certificate(Buffer.from(await response.arrayBuffer()));
+    if (!certificate.ca || Date.parse(certificate.validTo) < Date.now()) {
+      throw new Error(`Invalid or expired root certificate from ${url}.`);
+    }
+    roots.push(certificate.toString());
+  }
+  await mkdir(new URL('../src/zava-designer-agent-ui-demo/certs/', import.meta.url), { recursive: true });
+  await writeFile(new URL('../src/zava-designer-agent-ui-demo/certs/roots.pem', import.meta.url), roots.join('\n'));
+}
+
+async function preflight() {
+  const values = await environment();
+  requireValues(values, ['AZURE_ENV_NAME', 'AZURE_SUBSCRIPTION_ID', 'AZURE_LOCATION']);
+  const target = hostingTarget(values);
+  if (!/^[a-z0-9-]{1,60}$/i.test(values.AZURE_ENV_NAME)) throw new Error('Invalid azd environment name.');
+  await cli('az', ['account', 'show', '--subscription', values.AZURE_SUBSCRIPTION_ID, '--output', 'json']);
+  const groupName = `rg-${values.AZURE_ENV_NAME}`;
+  const exists = await cli('az', ['group', 'exists', '--name', groupName,
+    '--subscription', values.AZURE_SUBSCRIPTION_ID, '--output', 'tsv']);
+  if (exists === 'true') {
+    const group = JSON.parse(await cli('az', ['group', 'show', '--name', groupName,
+      '--subscription', values.AZURE_SUBSCRIPTION_ID, '--output', 'json']));
+    if (group.tags?.['azd-env-name'] !== values.AZURE_ENV_NAME
+        || group.tags?.purpose !== 'horizondb-workshop') {
+      throw new Error(`Refusing to modify an existing, unrelated resource group: ${groupName}.`);
+    }
+    requireValues(values, ['PG_ADMIN_PASSWORD', 'PG_APP_PASSWORD']);
+  }
+  let clientIp = values.AZURE_CLIENT_IP;
+  if (!clientIp) {
+    const response = await fetch('https://api.ipify.org?format=json', { signal: AbortSignal.timeout(20000) });
+    if (!response.ok) throw new Error(`Client IPv4 discovery failed: HTTP ${response.status}. Set AZURE_CLIENT_IP explicitly.`);
+    clientIp = (await response.json()).ip;
+  }
+  if (!isIPv4(clientIp) || clientIp === '0.0.0.0') {
+    throw new Error('AZURE_CLIENT_IP must be the client IPv4 address, not an allow-all-Azure rule.');
+  }
+  await setEnvironment('AZURE_CLIENT_IP', clientIp);
+  const envFile = new URL(`../.azure/${values.AZURE_ENV_NAME}/.env`, import.meta.url);
+  await chmod(envFile, 0o600);
+  await chmod(new URL(`../.azure/${values.AZURE_ENV_NAME}/`, import.meta.url), 0o700);
+  // Keep generated secrets out of child-process arguments and console output.
+  let envText = await readFile(envFile, 'utf8');
+  for (const name of ['PG_ADMIN_PASSWORD', 'PG_APP_PASSWORD']) {
+    if (!values[name]) {
+      envText = envText.replace(new RegExp(`^${name}=.*$`, 'gm'), '');
+      envText += `\n${name}="Z!${randomBytes(30).toString('base64url')}9a"\n`;
+    }
+  }
+  await writeFile(envFile, envText);
+  await setEnvironment('AZURE_HOSTING_TARGET', target);
+  await prepare();
+  console.log(`Prepared ${values.AZURE_ENV_NAME} in ${values.AZURE_LOCATION}; credentials are not displayed.`);
+}
+
+async function configure() {
+  const values = await environment();
+  const target = hostingTarget(values, true);
+  requireValues(values, ['AZURE_SUBSCRIPTION_ID', 'AZURE_HORIZONDB_CLUSTER_ID',
+    'AZURE_HORIZONDB_POOL_NAME', 'AZURE_HORIZONDB_PARAMETER_GROUP_ID', 'AZURE_WEB_RESOURCE_ID']);
+  const arm = azureClient(values.AZURE_SUBSCRIPTION_ID);
+  const poolId = `${values.AZURE_HORIZONDB_CLUSTER_ID}/pools/${values.AZURE_HORIZONDB_POOL_NAME}`;
+  const ready = resource => resource.properties.state === 'Ready'
+    && resource.properties.provisioningState === 'Succeeded';
+  let pool = await waitForResource(arm, poolId, horizonApi, ready, 'HorizonDB pool');
+  if (pool.properties.parameterGroup?.parameterGroupResourceId?.toLowerCase()
+      !== values.AZURE_HORIZONDB_PARAMETER_GROUP_ID.toLowerCase()) {
+    console.log('Assigning the AI extension parameter group.');
+    await arm('PATCH', poolId, horizonApi, { properties: { parameterGroup: {
+      parameterGroupResourceId: values.AZURE_HORIZONDB_PARAMETER_GROUP_ID, applyMethod: 'Immediate',
+    } } });
+    pool = await waitForResource(arm, poolId, horizonApi,
+      resource => ready(resource)
+        && resource.properties.parameterGroup?.parameterGroupResourceId?.toLowerCase()
+          === values.AZURE_HORIZONDB_PARAMETER_GROUP_ID.toLowerCase()
+        && ['InSync', 'PendingReboot', 'FailedToApply']
+          .includes(resource.properties.parameterGroup?.syncStatus), 'Parameter group assignment');
+  }
+  if (needsRestart(pool)) {
+    console.log('Restarting HorizonDB to apply static extension parameters.');
+    await arm('POST', `${poolId}/restart`, horizonApi);
+    await waitForResource(arm, poolId, horizonApi,
+      resource => ready(resource) && resource.properties.parameterGroup?.syncStatus === 'InSync',
+      'HorizonDB restart');
+  }
+  const cluster = await arm('GET', values.AZURE_HORIZONDB_CLUSTER_ID, horizonApi);
+  if (cluster.properties.aiModelManagement !== 'Enabled') {
+    console.log('Enabling managed embedding, chat and reranker models.');
+    await arm('PATCH', values.AZURE_HORIZONDB_CLUSTER_ID, horizonApi,
+      { properties: { aiModelManagement: 'Enabled' } });
+    await waitForResource(arm, values.AZURE_HORIZONDB_CLUSTER_ID, horizonApi,
+      resource => ready(resource) && resource.properties.aiModelManagement === 'Enabled', 'AI Model Management');
+  }
+  const endpoints = await arm('GET', `${values.AZURE_HORIZONDB_CLUSTER_ID}/endpoints`, horizonApi);
+  const hostname = readWriteHostname(endpoints);
+  const web = await arm('GET', values.AZURE_WEB_RESOURCE_ID,
+    target === 'containerapp' ? containerApi : webApi);
+  const addresses = firewallIps(values.AZURE_APP_EGRESS_IP);
+  const ruleNames = new Set(addresses.map(ip => `app-egress-${ip.replaceAll('.', '-')}`));
+  for (const ip of addresses) {
+    await arm('PUT', `${poolId}/firewallRules/app-egress-${ip.replaceAll('.', '-')}`, horizonApi,
+      { properties: { startIpAddress: ip, endIpAddress: ip } });
+  }
+  const rules = await arm('GET', `${poolId}/firewallRules`, horizonApi);
+  for (const rule of rules.value) {
+    if (rule.name.startsWith('app-egress-') && !ruleNames.has(rule.name)) {
+      await arm('DELETE', rule.id, horizonApi);
+    }
+  }
+  await setEnvironment('PGHOST', hostname);
+  if (target === 'containerapp') {
+    await arm('PATCH', values.AZURE_WEB_RESOURCE_ID, containerApi, containerDatabaseHost(web, hostname));
+    await waitForResource(arm, values.AZURE_WEB_RESOURCE_ID, containerApi,
+      resource => resource.properties.provisioningState === 'Succeeded', 'Container Apps configuration');
+  } else {
+    const settings = await arm('POST', `${values.AZURE_WEB_RESOURCE_ID}/config/appsettings/list`, webApi);
+    await arm('PUT', `${values.AZURE_WEB_RESOURCE_ID}/config/appsettings`, webApi,
+      { properties: { ...settings.properties, PGHOST: hostname } });
+    await arm('POST', `${values.AZURE_WEB_RESOURCE_ID}/config/configreferences/appsettings/refresh`, webApi);
+  }
+  console.log('Configured the service-generated database endpoint and narrowly scoped app firewall rules.');
+}
+
+async function seed() {
+  const values = await environment();
+  hostingTarget(values, true);
+  requireValues(values, ['PGHOST', 'PG_ADMIN_PASSWORD', 'PG_APP_PASSWORD']);
+  const client = await databaseClient(values);
+  let result;
+  try {
+    result = await bootstrap(client, values);
+  } finally {
+    await client.end();
+  }
+  const appClient = await databaseClient(values, 'zava_app', values.PG_APP_PASSWORD);
+  try {
+    await appClient.query('SET search_path = ag_catalog, public');
+    await appClient.query("SELECT count(*) FROM workshop.products");
+    await appClient.query(`SELECT * FROM ag_catalog.cypher('workshop_style',
+      $$MATCH (p:Product) RETURN count(p)$$) AS (count ag_catalog.agtype)`);
+  } finally {
+    await appClient.end();
+  }
+  await writeFile(new URL(`../.azure/${values.AZURE_ENV_NAME}/database-check.json`, import.meta.url),
+    `${JSON.stringify(result, null, 2)}\n`);
+  console.log('Verified 18 embeddings, DiskANN/BM25 indexes, AGE graph and the restricted application role.');
+}
+
+async function verify() {
+  const values = await environment();
+  requireValues(values, ['SERVICE_WEB_ENDPOINT']);
+  const endpoint = values.SERVICE_WEB_ENDPOINT;
+  const deadline = Date.now() + 10 * 60 * 1000;
+  let health;
+  let lastStatus;
+  while (Date.now() < deadline) {
+    const response = await fetch(`${endpoint}/api/health`, { signal: AbortSignal.timeout(30000) });
+    lastStatus = response.status;
+    if (response.ok) {
+      health = await response.json();
+      if (health.status === 'ok' && Number(health.products) === 18 && Number(health.embedded) === 18
+          && health.graph_ready === true) break;
+      throw new Error(`Invalid health response: ${JSON.stringify(health)}`);
+    }
+    console.log(`Waiting for application startup (HTTP ${lastStatus}).`);
+    await sleep(15000);
+  }
+  if (!health) throw new Error(`Application was not healthy within ten minutes (last HTTP ${lastStatus}).`);
+  const page = await fetch(endpoint, { signal: AbortSignal.timeout(30000) });
+  const html = await page.text();
+  const script = html.match(/<script[^>]+src="([^"]+)"/)?.[1];
+  if (!page.ok || !html.includes('id="root"') || !script) throw new Error('React application was not served.');
+  const bundle = await fetch(new URL(script, endpoint), { signal: AbortSignal.timeout(30000) });
+  if (!bundle.ok || !(await bundle.text()).includes('/api/design-room')) throw new Error('React bundle is missing.');
+  const invalid = await fetch(`${endpoint}/api/design-room`, {
+    method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ budget: -1 }),
+    signal: AbortSignal.timeout(30000),
+  });
+  if (invalid.status !== 400) throw new Error('Invalid input must be rejected without mock success.');
+  const budget = 2000;
+  const response = await fetch(`${endpoint}/api/design-room`, {
+    method: 'POST', headers: { 'content-type': 'application/json' },
+    body: JSON.stringify({ theme: 'scandinavian', budget,
+      priorities: ['seating', 'tables', 'lighting', 'rugs', 'storage', 'decor'] }),
+    signal: AbortSignal.timeout(180000),
+  });
+  const design = await response.json();
+  if (!response.ok) throw new Error(`Live design failed: HTTP ${response.status}: ${JSON.stringify(design)}`);
+  const tools = ['analyze_room_brief', 'get_semantic_context', 'hybrid_search_products',
+    'find_related_products_graph', 'filter_products', 'curate_room_picks'];
+  if (!Array.isArray(design.trace) || design.trace.length !== tools.length
+      || design.trace.some((step, index) => step.tool !== tools[index] || !step.sql)
+      || !Array.isArray(design.products) || design.products.length === 0 || design.products.length > 6
+      || design.products.some(product => !Number.isSafeInteger(product.id) || product.id < 1 || product.id > 18
+        || !Number.isFinite(product.price) || product.price <= 0)
+      || new Set(design.products.map(product => product.category)).size !== design.products.length
+      || design.products.reduce((sum, product) => sum + Math.round(product.price * 100), 0) > budget * 100) {
+    throw new Error('The live response failed the six-stage trace, catalog or budget checks.');
+  }
+  await writeFile(new URL(`../.azure/${values.AZURE_ENV_NAME}/verification.json`, import.meta.url),
+    `${JSON.stringify({ verifiedAt: new Date().toISOString(), health, design }, null, 2)}\n`);
+  console.log(`Verified React UI and a live six-stage HorizonDB design at ${endpoint}.`);
+}
+
+const actions = { prepare, preflight, configure, seed, verify };
+const action = actions[process.argv[2]];
+if (!action) throw new Error('Specify prepare, preflight, configure, seed or verify.');
+try {
+  await action();
+} catch (error) {
+  console.error(`Zava ${process.argv[2]} failed: ${error.message}`);
+  process.exitCode = 1;
+}
diff --git a/scripts/psql.mjs b/scripts/psql.mjs
