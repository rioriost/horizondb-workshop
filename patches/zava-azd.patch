+name: zava-horizondb-workshop
+metadata:
+  template: zava-horizondb-workshop
+requiredVersions:
+  azd: '>=1.37.1'
+infra:
+  provider: bicep
+  path: infra
+workflows:
+  up:
+    steps:
+      - azd: provision
+      - azd: package
+      - azd: deploy --all
+services:
+  web:
+    condition: ${AZURE_DEPLOY_CONTAINER_APPS=true}
+    project: src/zava-designer-agent-ui-demo
+    language: js
+    host: containerapp
+    docker:
+      path: ./Dockerfile
+      remoteBuild: true
+  webapp:
+    condition: ${AZURE_DEPLOY_APP_SERVICE=false}
+    project: src/zava-designer-agent-ui-demo
+    language: js
+    host: appservice
+hooks:
+  preup:
+    shell: sh
+    run: node scripts/hooks.mjs preflight
+  prepackage:
+    shell: sh
+    run: node scripts/hooks.mjs prepare
+  preprovision:
+    shell: sh
+    run: node scripts/hooks.mjs preflight
+  postprovision:
+    shell: sh
+    run: node scripts/hooks.mjs configure
+  predeploy:
+    shell: sh
+    run: node scripts/hooks.mjs configure && node scripts/hooks.mjs seed
+  postdeploy:
+    shell: sh
+    run: node scripts/hooks.mjs verify
