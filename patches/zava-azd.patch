--- /dev/null
+++ b/sql/bootstrap.sql
@@ -0,0 +1,40 @@
+CREATE EXTENSION IF NOT EXISTS vector;
+CREATE EXTENSION IF NOT EXISTS pg_diskann;
+CREATE EXTENSION IF NOT EXISTS pg_textsearch;
+CREATE EXTENSION IF NOT EXISTS azure_ai;
+CREATE EXTENSION IF NOT EXISTS pg_durable;
+CREATE EXTENSION IF NOT EXISTS age;
+SET search_path = ag_catalog, public;
+
+DO $$
+DECLARE
+    installed text;
+BEGIN
+    SELECT extversion INTO installed FROM pg_extension WHERE extname = 'azure_ai';
+    IF string_to_array(installed, '.')::integer[] < ARRAY[2, 5, 6] THEN
+        RAISE EXCEPTION 'azure_ai >= 2.5.6 is required; installed: %.', installed;
+    END IF;
+    IF NOT EXISTS (
+        SELECT 1 FROM pg_proc AS p JOIN pg_namespace AS n ON n.oid = p.pronamespace
+        WHERE n.nspname = 'ai' AND p.proname = 'search'
+          AND p.proargnames @> ARRAY['embedding_model', 'rerank_model', 'ctid']
+    ) THEN
+        RAISE EXCEPTION 'The native ai.search ctid API is required.';
+    END IF;
+END $$;
+
+CREATE SCHEMA IF NOT EXISTS workshop;
+CREATE TABLE IF NOT EXISTS workshop.products (
+    id integer PRIMARY KEY,
+    title text NOT NULL,
+    title_ja text NOT NULL,
+    category text NOT NULL CHECK (category IN
+        ('seating', 'tables', 'lighting', 'rugs', 'storage', 'decor')),
+    price numeric(10, 2) NOT NULL CHECK (price > 0),
+    rating real NOT NULL CHECK (rating BETWEEN 0 AND 5),
+    style text NOT NULL CHECK (style IN ('scandinavian', 'mid-century', 'industrial')),
+    content text NOT NULL
+);
+COMMENT ON TABLE workshop.products IS 'Original fictional furniture catalog for the HorizonDB workshop.';
+COMMENT ON COLUMN workshop.products.content IS 'English searchable description; Japanese display title is title_ja.';
+ALTER TABLE workshop.products ADD COLUMN IF NOT EXISTS embedding vector(1536);
diff --git a/sql/graph.sql b/sql/graph.sql
new file mode 100644
index 0000000..782f0c4
--- /dev/null
+++ b/sql/graph.sql
@@ -0,0 +1,30 @@
+SET search_path = ag_catalog, public;
+SELECT ag_catalog.create_graph('workshop_style');
+SELECT * FROM ag_catalog.cypher('workshop_style', $$
+    CREATE (:Style {name: 'scandinavian'}),
+           (:Style {name: 'mid-century'}),
+           (:Style {name: 'industrial'})
+$$) AS (node ag_catalog.agtype);
+
+DO $$
+DECLARE
+    product record;
+    statement text;
+BEGIN
+    FOR product IN SELECT id, style FROM workshop.products ORDER BY id LOOP
+        statement := format(
+            'MATCH (s:Style {name: %s}) CREATE (:Product {id: %s})-[:HAS_STYLE]->(s)',
+            to_json(product.style)::text, product.id
+        );
+        EXECUTE format(
+            'SELECT * FROM ag_catalog.cypher(%L, $cypher$%s$cypher$) AS (node ag_catalog.agtype)',
+            'workshop_style', statement
+        );
+    END LOOP;
+END $$;
+
+SELECT * FROM ag_catalog.cypher('workshop_style', $$
+    MATCH (a:Style {name: 'scandinavian'}), (b:Style {name: 'mid-century'}),
+          (c:Style {name: 'industrial'})
+    CREATE (a)-[:SIMILAR_TO]->(b), (b)-[:SIMILAR_TO]->(c)
+$$) AS (edge ag_catalog.agtype);
